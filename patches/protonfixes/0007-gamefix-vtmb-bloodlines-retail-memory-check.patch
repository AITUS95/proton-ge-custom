index cabf10a..da83df8 100755
--- a/gamefixes-steam/default.py
+++ b/gamefixes-steam/default.py
@@ -4,7 +4,7 @@ even if no game fix is present. It is run before game fixes are applied.
 """
 
 import sys
-from protonfixes import util
+from protonfixes import exe_fixes, util
 
 
 def main() -> None:
@@ -33,3 +33,6 @@ def main() -> None:
                     util.replace_command(repl_opt, repl_val)
 
     use_steam_commands()
+
+    # Retail games added as non-Steam shortcuts have no fixed app id
+    exe_fixes.apply()
diff --git a/gamefixes-umu/default.py b/gamefixes-umu/default.py
index 9d832c2..1341a62 100755
--- a/gamefixes-umu/default.py
+++ b/gamefixes-umu/default.py
@@ -3,6 +3,11 @@ This file is always executed for games that are identified as UMU games,
 even if no game fix is present. It is run before game fixes are applied.
 """
 
+from protonfixes import exe_fixes
+
 
 def main() -> None:
     """Global defaults"""
+
+    # Retail games without a umu database entry run as umu-0
+    exe_fixes.apply()
